# Server Configuration
PORT=5000
NODE_ENV=development

# Python Face Recognition Microservice URL
PYTHON_ENGINE_URL=http://localhost:5001

# Supabase Credentials (PostgreSQL Persistence & Cloud Image Storage)
# Replace with your actual project URL and API key from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Buckets in Supabase
SUPABASE_AVATARS_BUCKET=attendance-avatars
SUPABASE_SNAPSHOTS_BUCKET=attendance-snapshots

# Attendance Rule Defaults
RECOGNITION_TOLERANCE=0.52
COOLDOWN_MINUTES=5
LATE_CUTOFF_TIME=09:15:00
